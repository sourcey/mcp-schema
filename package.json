{
  "name": "mcp-schema",
  "version": "0.3.3",
  "description": "TypeScript types and JSON Schema for MCP server specifications. Define, validate, and share static snapshots of Model Context Protocol servers.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./agent-plugins": {
      "types": "./dist/agent-plugins.d.ts",
      "import": "./dist/agent-plugins.js"
    },
    "./agent-plugins/mcp.schema.json": "./dist/agent-plugins/mcp.schema.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-agent-plugins.mjs",
    "docs:build": "cd docs && sourcey build -o ../.sourcey/docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "generate:agent-plugins": "node scripts/generate-agent-plugins.mjs",
    "check:agent-plugins": "node scripts/generate-agent-plugins.mjs --check"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "json-schema-to-typescript": "16.0.0",
    "sourcey": "^3.8.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "schema",
    "types",
    "typescript",
    "json-schema",
    "ai",
    "llm",
    "agent",
    "tools",
    "documentation",
    "spec",
    "specification"
  ],
  "author": "Kam Low <oss@0state.com> (https://sourcey.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sourcey/mcp-schema.git"
  },
  "bugs": {
    "url": "https://github.com/sourcey/mcp-schema/issues"
  },
  "homepage": "https://github.com/sourcey/mcp-schema"
}
